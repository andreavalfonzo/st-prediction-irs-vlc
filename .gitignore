# IRS-VLC: mantener código, documentación y resultados seleccionados.
# Los archivos ignorados permanecen en el equipo; no se incluyen en git add.

# --- Entornos de Python y configuración local ---
.venv/
venv/
env/
ENV/
.Python
.env
.env.*
!.env.example
!.env.sample
.envrc
.pypirc

# --- Cachés, bytecode y paquetes generados ---
__pycache__/
*.py[codz]
*$py.class
.cache/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/
.eggs/
*.egg-info/
*.egg
/build/
/dist/

# --- Archivos generados por pruebas y cobertura ---
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# --- Temporales, copias de respaldo y archivos del editor/sistema ---
/tmp/
/temp/
*.tmp
*.temp
*.bak
*.log
*~
*.swp
*.swo
.idea/
.DS_Store
Thumbs.db
Desktop.ini
tempCodeRunnerFile.py

# --- Auxiliares de LaTeX (conservar fuentes .tex/.bib y PDF finales) ---
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.out
*.lof
*.lot
*.nav
*.snm
*.vrb
*.xdv
*.dvi

# --- Pesos entrenados, matrices y archivos comprimidos pesados ---
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.rar
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz

# --- Simulaciones: excluir corridas completas y conservar evidencia resumida ---
# Estos datos permiten regenerar la figura y comprobar las cifras del paper.
# Las trazas por instante, los checkpoints y las carpetas por escenario se omiten.
/resultados/*
!/resultados/estres_movilidad/
/resultados/estres_movilidad/*
!/resultados/estres_movilidad/config.json
!/resultados/estres_movilidad/provenance.json
!/resultados/estres_movilidad/metrics_by_window.csv
!/resultados/estres_movilidad/episode_metrics.csv
!/resultados/estres_movilidad/paired_differences.csv
!/resultados/estres_movilidad/alignment_by_window.csv
!/resultados/estres_movilidad/informe.md
# Conservar las imágenes que el informe enlaza; omitir los PDF duplicados.
!/resultados/estres_movilidad/respuesta_evento.png
!/resultados/estres_movilidad/resumen_postevento.png
!/resultados/estres_movilidad/trayectorias_estres.png

# --- Entregables seleccionados para el paper ---
# Añadir aquí futuras versiones finales; no ignorar PDF/PNG/CSV globalmente.
# La carpeta figuras/ también se conserva para los gráficos del modelo físico.
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/mobility_stress_results_en.pdf
!/output/pdf/mobility_stress_results_en.png
!/output/pdf/mobility_stress_results_en.tex
!/output/pdf/mobility_stress_results_en_data.csv
!/output/pdf/mobility_stress_results_en_source.json
